{
  "name": "league",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:clean": "rimraf .nuxt .output .vercel && nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && git config core.hooksPath .githooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:paths": "node scripts/check-file-paths.mjs",
    "check:paths:fix": "node scripts/check-file-paths.mjs --fix",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit --format json",
    "fallow:health": "fallow health --score --hotspots --targets",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:nuxt": "vitest run test/nuxt",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "cross-env PW_SLOWMO=1 playwright test"
  },
  "dependencies": {
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@formkit/auto-animate": "^0.10.0",
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/simple-icons": "^1.2.91",
    "@internationalized/date": "^3.12.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "10.5.0",
    "@nuxtjs/robots": "6.1.3",
    "@nuxtjs/supabase": "2.0.9",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "1.0.2",
    "@pinia/colada-plugin-cache-persister": "^1.1.0",
    "@pinia/nuxt": "1.0.1",
    "@supabase/supabase-js": "2.110.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "14.3.0",
    "echarts": "^6.1.0",
    "fast-levenshtein": "^3.0.0",
    "mana-font": "^1.18.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "0.5.29",
    "nuxt-echarts": "1.0.1",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3",
    "uisfx": "^0.4.0",
    "valibot": "^1.4.2",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.62.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/vue-table": "8.21.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "fallow": "^3.9.1",
    "happy-dom": "^20.11.1",
    "pinia": "^4.0.2",
    "rimraf": "^6.1.3",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@11.4.0",
  "volta": {
    "node": "24.18.0"
  }
}
